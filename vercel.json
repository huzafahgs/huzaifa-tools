{
    "version": 2,
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/blog/image-optimization-for-google",
            "destination": "/blog/image-compression-and-seo",
            "permanent": true
        },
        {
            "source": "/blog/image-seo-guide",
            "destination": "/blog/image-compression-and-seo",
            "permanent": true
        },
        {
            "source": "/blog/reduce-website-loading-time",
            "destination": "/blog/website-speed-optimization",
            "permanent": true
        }
    ],
    "builds": [
        {
            "src": "api/ai.js",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/ai",
            "dest": "/api/ai.js"
        },
        {
            "handle": "filesystem"
        }
    ]
}
