{
    "version": 2,
    "cleanUrls": true,
    "builds": [
        {
            "src": "api/ai.js",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/ai",
            "dest": "/api/ai.js"
        },
        {
            "handle": "filesystem"
        }
    ]
}
